# AttriGuard Environment Configuration Example
# Copy this file to .env and customize values for your deployment.

# ==============================================================================
# Database Configuration (PostgreSQL / AWS RDS)
# ==============================================================================
POSTGRES_USER=attriguard
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=attrition_db
USE_POSTGRES=false

# Full connection string override (e.g. for AWS RDS)
# DATABASE_URL=postgresql://attriguard:password@your-rds-endpoint.rds.amazonaws.com:5432/attrition_db

# ==============================================================================
# FastAPI Backend Configuration
# ==============================================================================
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS="http://localhost:3000,http://localhost:80,http://localhost"
MODEL_PATH=models/attrition_pipeline.pkl

# ==============================================================================
# Frontend Configuration
# ==============================================================================
VITE_API_URL=/api

# ==============================================================================
# AWS Deployment Settings (For Reference / CI/CD)
# ==============================================================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_BACKEND_REPO=attriguard-backend
ECR_FRONTEND_REPO=attriguard-frontend
ECS_CLUSTER_NAME=attriguard-cluster
ECS_SERVICE_NAME=attriguard-service
